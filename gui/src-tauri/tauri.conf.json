{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis Desktop",
  "version": "0.1.0",
  "identifier": "com.jarvis.desktop",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "dist"
  },
  "app": {
    "security": {
      "capabilities": ["main"]
    },
    "windows": [
      {
        "title": "Jarvis Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": ".*"
    }
  }
}